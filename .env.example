# Copy to `.env` to override the host ports Docker Compose publishes.
# Compose reads `.env` automatically; only the host side changes, so the app
# still listens on 80 (web) / 5173 (dev) / 3001 (server) inside the containers.

# Production (nginx) — the port you open in the browser. Default: 8080.
WEB_PORT=8080

# Development (Vite hot-reload) server. Default: 5173.
DEV_PORT=5173
